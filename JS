// ── Section: Progress Chart ───────────────────────────────────────────────────
function ProgressChart({ toast }) {
  const [ref, inView] = useInView(0.1);
  const weeks = ["W1","W2","W3","W4","W5","W6"];
  const weights = [84.2, 83.8, 83.1, 82.5, 82.0, 81.4];
  const lifts   = [100, 107, 112, 115, 120, 125];
  const [showWeight, setShowWeight] = useState(true);
  const data = showWeight ? weights : lifts;
  const min = Math.min(...data) - 1;
  const max = Math.max(...data) + 1;
  const W = 560, H = 160, pad = { l:40, r:20, t:16, b:30 };
  const gW = W - pad.l - pad.r;
  const gH = H - pad.t - pad.b;
  const scaleY = v => pad.t + gH - ((v - min) / (max - min)) * gH;
  const scaleX = i => pad.l + (i / (data.length-1)) * gW;
  const pts = data.map((v,i) => `${scaleX(i)},${scaleY(v)}`).join(" ");
  const pathD = data.map((v,i) => `${i===0?"M":"L"}${scaleX(i)} ${scaleY(v)}`).join(" ");

  return (
    <section ref={ref} style={{
      padding:"56px 48px", maxWidth:1200, margin:"0 auto",
      opacity: inView ? 1 : 0, transform: inView ? "none" : "translateY(24px)",
      transition:"opacity 0.6s ease, transform 0.6s ease",
    }}>
      <div style={{ display:"flex", alignItems:"baseline", justifyContent:"space-between", marginBottom:24 }}>
        <div>
          <span style={{ display:"block", fontSize:11, letterSpacing:"0.14em", textTransform:"uppercase", color:T.accent, marginBottom:6, fontFamily:T.body }}>6-Week Progress</span>
          <h2 style={{ fontFamily:T.font, fontWeight:900, fontSize:44, textTransform:"uppercase" }}>Your Gains</h2>
        </div>
        <div style={{ display:"flex", gap:6 }}>
          {["Weight (kg)","Bench (kg)"].map((l,i) => (
            <button key={i} onClick={() => setShowWeight(i===0)} style={{
              fontSize:12, letterSpacing:"0.06em", padding:"7px 14px",
              border:`0.5px solid ${(showWeight&&i===0)||(!showWeight&&i===1) ? T.lime : "#333"}`,
              borderRadius:4, cursor:"pointer", fontFamily:T.body,
              background:(showWeight&&i===0)||(!showWeight&&i===1) ? T.lime : "transparent",
              color:(showWeight&&i===0)||(!showWeight&&i===1) ? T.dark : T.muted,
              transition:"all 0.2s",
            }}>{l}</button>
          ))}
        </div>
      </div>

      <div style={{ background:T.card, border:`0.5px solid ${T.border}`, borderRadius:14, padding:"24px 24px 8px", overflow:"hidden" }}>
        <svg width="100%" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" style={{ display:"block" }}>
          {/* Grid lines */}
          {[0,0.25,0.5,0.75,1].map(t => {
            const y = pad.t + t * gH;
            const v = (max - t*(max-min)).toFixed(1);
            return (
              <g key={t}>
                <line x1={pad.l} y1={y} x2={W-pad.r} y2={y} stroke={T.border} strokeWidth="0.5" />
                <text x={pad.l-6} y={y+4} textAnchor="end" fill={T.muted} fontSize="9" fontFamily={T.body}>{v}</text>
              </g>
            );
          })}
          {/* X labels */}
          {weeks.map((w,i) => (
            <text key={i} x={scaleX(i)} y={H-6} textAnchor="middle" fill={T.muted} fontSize="10" fontFamily={T.body}>{w}</text>
          ))}
          {/* Area fill */}
          <path d={`${pathD} L${scaleX(data.length-1)} ${H-pad.b} L${pad.l} ${H-pad.b} Z`}
            fill={showWeight ? T.lime : T.blue} opacity="0.06" />
          {/* Line */}
          <path d={pathD} fill="none" stroke={showWeight ? T.lime : T.blue} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
          {/* Dots */}
          {data.map((v,i) => (
            <circle key={i} cx={scaleX(i)} cy={scaleY(v)} r="4" fill={showWeight ? T.lime : T.blue} />
          ))}
        </svg>

        {/* Stat row */}
        <div style={{ display:"grid", gridTemplateColumns:"repeat(3,1fr)", gap:1, borderTop:`0.5px solid ${T.border}`, marginTop:8 }}>
          {[
            { label:"Start",  val: `${data[0]}${showWeight?" kg":" kg"}` },
            { label:"Current",val: `${data[data.length-1]}${showWeight?" kg":" kg"}` },
            { label:"Change", val: `${showWeight ? "−" : "+"}${Math.abs(data[data.length-1]-data[0]).toFixed(1)} kg` },
          ].map((s,i) => (
            <div key={i} style={{ padding:"14px 16px", borderRight: i<2 ? `0.5px solid ${T.border}` : "none" }}>
              <div style={{ fontSize:11, color:T.muted, textTransform:"uppercase", letterSpacing:"0.06em", marginBottom:4, fontFamily:T.body }}>{s.label}</div>
              <div style={{ fontFamily:T.font, fontWeight:700, fontSize:24, color: i===2 ? T.lime : T.text }}>{s.val}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}

